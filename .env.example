# Copie para .env antes de subir a infra local (valores abaixo são apenas locais).

# Portas da aplicação
API_PORT=4000
WEB_PORT=3000
DOCS_PORT=3001

# Portas da stack LGTM
GRAFANA_PORT=3002
LOKI_PORT=3100
TEMPO_PORT=3200
PROMETHEUS_PORT=9090

# Portas do Supabase local (gerenciadas pela CLI)
SUPABASE_API_PORT=54321
SUPABASE_DB_PORT=54322
SUPABASE_STUDIO_PORT=54323

# Acesso ao Grafana local (troque a senha antes de usar fora da máquina)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-only

# Clientes locais — obtenha as chaves anônima e de serviço com `supabase status`
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
