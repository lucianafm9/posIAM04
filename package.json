{
  "name": "coders-university-module-4",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "code:fix": "npm run format && turbo run lint --force -- --fix",
    "types:check": "npm run check-types",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "infra:up": "node scripts/infra.mjs up",
    "infra:down": "node scripts/infra.mjs down",
    "db:migrate": "node scripts/infra.mjs migrate",
    "commit-and-push": "node scripts/commit-and-push.mjs",
    "prepare": "husky",
    "commitlint": "commitlint",
    "commitlint:last": "commitlint --last"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "husky": "9.1.7",
    "prettier": "3.9.6",
    "turbo": "^2.11.13",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.19.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
